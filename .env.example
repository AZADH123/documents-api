# ====================================================================
# Example environment configuration.
# Copy this file to ".env" and tweak the values:
#     cp .env.example .env
# The app reads from .env automatically via pydantic-settings.
# ====================================================================

# Human-friendly name shown in the API docs and logs.
APP_NAME=Documents API

# "development" or "production". Controls error verbosity, docs, etc.
APP_ENV=development

# When true, Uvicorn auto-reloads on file changes (great for dev).
DEBUG=true

# Host and port the server binds to.
# 0.0.0.0 means "all network interfaces" (so Docker can reach it).
HOST=0.0.0.0
PORT=8000