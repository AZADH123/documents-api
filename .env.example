APP_NAME=Documents API
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ====================================================================
# Auth settings
# ====================================================================
# IMPORTANT: change this to a long random string in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60